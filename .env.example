# FeedLite environment variables example.
# Copy this file to .env and adjust values for your deployment.
# Keep .env private. It contains credentials, tokens, proxy URLs, and AI endpoints.

# --- Authentication ---
# Used for the first admin user seed and for login checks.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Generate a unique production secret:
#   openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_DAYS=30

# Local troubleshooting only. Keep false in production.
DISABLE_AUTH=false

# Disable /docs, /redoc, and /openapi.json in production.
DISABLE_DOCS=false

# --- AI: scorer ---
# Supports provider values: openai, gemini, google, anthropic.
# API keys and private gateway URLs belong here, not in config.yml.
SCORER_PROVIDER=openai
SCORER_MODEL=gpt-4o-mini
SCORER_API_BASE=https://api.openai.com/v1
SCORER_API_KEY=replace-with-scorer-api-key

# --- AI: profiler ---
PROFILER_PROVIDER=openai
PROFILER_MODEL=gpt-4o-mini
PROFILER_API_BASE=https://api.openai.com/v1
PROFILER_API_KEY=replace-with-profiler-api-key

# --- AI proxy (optional) ---
# Applies only to AI API requests. Supports http:// and socks5:// URLs.
# Inside Docker, use 172.17.0.1 to access a proxy running on the host.
# AI_SPECIFIC_PROXY=socks5://172.17.0.1:40000
AI_SPECIFIC_PROXY=

# --- RAG API ---
# Required only when exposing /api/rag/* to OpenClaw or other internal callers.
RAG_API_KEY=
